const { Rating, User, Project, TeamMember, sequelize } = require('../models');

exports.submitRating = async (req, res) => {
  try {
    const { ratee_id, project_id, score, review } = req.body;
    if (req.user.id === parseInt(ratee_id))
      return res.status(400).json({ message: 'Cannot rate yourself' });

    const isMember = await TeamMember.findOne({
      where: { project_id, user_id: req.user.id, status: 'active' },
    });
    if (!isMember) return res.status(403).json({ message: 'Not a project member' });

    const existing = await Rating.findOne({ where: { rater_id: req.user.id, ratee_id, project_id } });
    if (existing) return res.status(400).json({ message: 'Already rated this user for this project' });

    const rating = await Rating.create({ rater_id: req.user.id, ratee_id, project_id, score, review });

    // Update avg_rating on user
    const allRatings = await Rating.findAll({ where: { ratee_id } });
    const avg = allRatings.reduce((sum, r) => sum + r.score, 0) / allRatings.length;
    await User.update({ avg_rating: parseFloat(avg.toFixed(2)), total_ratings: allRatings.length }, { where: { id: ratee_id } });

    return res.status(201).json(rating);
  } catch (err) {
    return res.status(500).json({ message: err.message });
  }
};

exports.getUserRatings = async (req, res) => {
  try {
    const ratings = await Rating.findAll({
      where: { ratee_id: req.params.userId },
      include: [
        { model: User, as: 'rater', attributes: ['id', 'name', 'avatar_url'] },
        { model: Project, attributes: ['id', 'title'] },
      ],
      order: [['created_at', 'DESC']],
    });
    return res.json(ratings);
  } catch (err) {
    return res.status(500).json({ message: err.message });
  }
};

exports.getProjectRatings = async (req, res) => {
  try {
    const ratings = await Rating.findAll({
      where: { project_id: req.params.projectId },
      include: [
        { model: User, as: 'rater', attributes: ['id', 'name', 'avatar_url'] },
        { model: User, as: 'ratee', attributes: ['id', 'name', 'avatar_url'] },
      ],
    });
    return res.json(ratings);
  } catch (err) {
    return res.status(500).json({ message: err.message });
  }
};
